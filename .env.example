# Safe local-development defaults. Copy this file to .env to override them.
POSTGRES_DB=kds_club_manager
POSTGRES_USER=kds
POSTGRES_PASSWORD=kds_dev_password
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5175
JWT_SECRET=kds-local-development-signing-key-change-before-production-2026
DEVELOPMENT_RESET_DELIVERY=true
DEVELOPMENT_INVITATION_DELIVERY=true
FRONTEND_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
FRONTEND_URL=http://localhost:5175
STORAGE_PROVIDER=local
KDS_STORAGE_ROOT=/var/lib/kds-storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=kds-private
NOTIFICATION_EMAIL_PROVIDER=log
NOTIFICATION_FROM_ADDRESS=no-reply@kds.local
NOTIFICATION_DELIVERY_INTERVAL=PT1M
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_HEALTH_ENABLED=false
