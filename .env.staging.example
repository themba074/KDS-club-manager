# Copy to .env.staging on the staging host and replace every placeholder.
# Never commit the populated file.
DB_URL=jdbc:postgresql://database-host:5432/kds_club_manager
DB_USERNAME=replace-me
DB_PASSWORD=replace-me
JWT_SECRET=replace-with-at-least-32-random-bytes
FRONTEND_ORIGINS=https://staging.example.com
FRONTEND_URL=https://staging.example.com
SUPABASE_URL=https://project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=kds-private
NOTIFICATION_FROM_ADDRESS=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
STAGING_HTTP_BIND=127.0.0.1:8080
